# MT5 account credentials
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_MT5_SERVER

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=YOUR_INFLUX_TOKEN
INFLUXDB_ORG=YOUR_INFLUX_ORG
INFLUXDB_BUCKET=forex_data

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forex_metadata
POSTGRES_USER=forex_user
POSTGRES_PASSWORD=forex_pass_2026

# Technical agent risk mode (small account)
FX_SMALL_ACCOUNT_MODE=1
FX_SMALL_ACCOUNT_MAX_BALANCE=150
FX_SMALL_ACCOUNT_MIN_MARGIN_LEVEL=200
FX_SMALL_ACCOUNT_MIN_FREE_MARGIN=20
FX_SMALL_ACCOUNT_MAX_OPEN_POSITIONS=1
FX_SMALL_ACCOUNT_CONFIDENCE_CAP=0.65

# LLM provider for the technical agent
# local = Ollama
# tokenfactory = Token Factory API compatible OpenAI endpoint
FX_LLM_PROVIDER=local
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

TOKEN_FACTORY_BASE_URL=https://tokenfactory.esprit.tn/api
TOKEN_FACTORY_MODEL=hosted_vllm/Llama-3.1-70B-Instruct
TOKEN_FACTORY_API_KEY=YOUR_TOKEN_FACTORY_API_KEY

# Default pair for technical agent runs
FX_DEFAULT_SYMBOL=EURUSD

# Run all configured pairs in one pass
FX_RUN_ALL_SYMBOLS=1