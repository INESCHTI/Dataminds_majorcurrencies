# Live Data Provider Credentials
# Using simulation mode by default - no API credentials needed

# OANDA API Configuration (DISABLED - using simulation)
# OANDA_API_KEY=your_oanda_api_key_here
# OANDA_ACCOUNT_ID=your_oanda_account_id_here
# OANDA_ENVIRONMENT=practice  # or "live" for production

# FXCM API Configuration (DISABLED - using simulation)
# FXCM_API_KEY=your_fxcm_api_key_here
# FXCM_ENVIRONMENT=demo  # or "live" for production

# Live Data Configuration
LIVE_DATA_MODE=simulation  # simulation, oanda, or fxcm
FALLBACK_TO_SIMULATION=true

# Risk Management Settings
MAX_PORTFOLIO_RISK=0.02  # 2% max portfolio risk
MAX_POSITION_RISK=0.01   # 1% max position risk
MAX_POSITIONS=10          # Max concurrent positions
MIN_TRADE_SIZE=1000      # Minimum trade size
MAX_LEVERAGE=50.0        # Maximum leverage

# Performance Tracking
INITIAL_BALANCE=100000.0
PERFORMANCE_LOOKBACK_DAYS=30

# Backtesting
BACKTEST_INITIAL_BALANCE=100000.0
COMMISSION_RATE=0.0002  # 0.02% commission
